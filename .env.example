# Copy to .env and fill in the values. Never commit .env.

# PostgreSQL in Docker (docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Connection string for the app (Drizzle)
# Format: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=
