# Copy to .env and fill in the values. Never commit .env.

# PostgreSQL in Docker (docker-compose.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Connection string for the app (Drizzle)
# Format: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>
DATABASE_URL=

BETTER_AUTH_SECRET=        # в .env: результат команды `openssl rand -base64 32`
BETTER_AUTH_URL=           # в .env: http://localhost:3000
SMTP_URL=                  # в .env: smtp://127.0.0.1:1025
MAIL_FROM=                 # в .env: Личная CRM <noreply@mail.crm.context-crm.site>
OWNER_EMAIL=               # в .env: ваша почта
