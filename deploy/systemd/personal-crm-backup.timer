# Runs the daily backup of the prod database at 03:00 Moscow time. Persistent: if the server was off
# at 03:00, the backup runs right after it starts. Installed by setup-server.sh.
# When it runs next and ran last: systemctl list-timers personal-crm-backup.timer
[Unit]
Description=Daily backup of the personal-crm prod database at 03:00 Moscow time

[Timer]
OnCalendar=*-*-* 03:00:00 Europe/Moscow
Persistent=true

[Install]
WantedBy=timers.target
